@inproceedings{aulbach2008,
  author    = {Aulbach, Stefan and Grust, Torsten and Jacobs, Dean and Kemper, Alfons and Rittinger, Jan},
  title     = {{Multi-Tenant Databases for Software as a Service: Schema-Mapping Techniques}},
